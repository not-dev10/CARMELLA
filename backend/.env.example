# ================================
# CARMELLA BACKEND - ENVIRONMENT VARIABLES
# ================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ================================
# SERVER CONFIGURATION
# ================================

# Server port (default: 5000)
PORT=5000

# Environment: development, staging, production
NODE_ENV=development

# ================================
# SUPABASE CONFIGURATION
# ================================

# Your Supabase project URL
# Get from: https://supabase.com/dashboard -> Settings -> API
# Example: https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (public key for client-side)
# Get from: https://supabase.com/dashboard -> Settings -> API -> anon key
# This is safe to expose in frontend code
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Key (KEEP SECRET - backend only!)
# Get from: https://supabase.com/dashboard -> Settings -> API -> service_role key
# ⚠️ NEVER expose this in frontend or version control
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ================================
# GOOGLE OAUTH CONFIGURATION
# ================================

# Google OAuth Client ID
# Get from: https://console.cloud.google.com/apis/credentials
# For development, use OAuth 2.0 Client IDs (Web application)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth Client Secret
# ⚠️ KEEP THIS SECRET - Never expose in frontend
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ================================
# FRONTEND CONFIGURATION
# ================================

# CORS Origin - Frontend URL
# For development: http://localhost:5173 (Vite default)
# For production: https://yourdomain.com
CORS_ORIGIN=http://localhost:5173

# ================================
# NOTES & INSTRUCTIONS
# ================================
#
# SETUP STEPS:
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Fill in your actual values in .env
#
# 3. NEVER commit .env to git:
#    .env is in .gitignore
#
# 4. Get Supabase credentials:
#    a) Go to https://supabase.com/dashboard
#    b) Select your project
#    c) Click Settings → API
#    d) Copy SUPABASE_URL and keys
#
# 5. Get Google OAuth credentials:
#    a) Go to https://console.cloud.google.com
#    b) Create a new project or select existing
#    c) Enable Google+ API
#    d) Create OAuth 2.0 credentials (Web application)
#    e) Set authorized redirect URIs:
#       - http://localhost:5000 (development)
#       - https://yourdomain.com (production)
#    f) Copy Client ID and Secret
#
# ENVIRONMENT-SPECIFIC VALUES:
#
# DEVELOPMENT:
#   PORT=5000
#   NODE_ENV=development
#   CORS_ORIGIN=http://localhost:5173
#   SUPABASE_URL=<your-dev-project-url>
#   SUPABASE_ANON_KEY=<your-dev-anon-key>
#   SUPABASE_SERVICE_KEY=<your-dev-service-key>
#   GOOGLE_CLIENT_ID=<your-dev-client-id>
#   GOOGLE_CLIENT_SECRET=<your-dev-client-secret>
#
# PRODUCTION:
#   PORT=3001 (or your production port)
#   NODE_ENV=production
#   CORS_ORIGIN=https://yourdomain.com
#   SUPABASE_URL=<your-prod-project-url>
#   SUPABASE_ANON_KEY=<your-prod-anon-key>
#   SUPABASE_SERVICE_KEY=<your-prod-service-key>
#   GOOGLE_CLIENT_ID=<your-prod-client-id>
#   GOOGLE_CLIENT_SECRET=<your-prod-client-secret>
#
# HOSTING PLATFORMS:
#
# Vercel:
#   - Set env vars in: Settings → Environment Variables
#   - Auto-deploy on git push
#
# Railway:
#   - Set env vars in: Project → Variables
#   - Configure from: dashboard.railway.app
#
# Render:
#   - Set env vars in: Environment
#   - Configure from: dashboard.render.com
 