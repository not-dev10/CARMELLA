# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# S3 Configuration
# Image uploads are handled via backend-generated signed URLs
# No frontend S3 configuration required
# Backend must have AWS credentials configured (see backend/.env)

# API Configuration
VITE_API_URL=http://localhost:5000/api
